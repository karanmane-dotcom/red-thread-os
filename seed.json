[{"op": "set", "path": "os_settings/main", "data": {"id": "main", "hoursPerFte": 160, "fteRate": 180000, "by": "Setup", "at": "2026-11-13T00:00:00.000Z"}}, {"op": "set", "path": "os_clients/sa-tourism", "data": {"id": "sa-tourism", "name": "SA Tourism", "agency": "Zoo Media", "by": "Setup", "at": "2026-11-13T00:00:00.000Z", "category": "Travel & Tourism", "contacts": "Neliswa (regional lead), Mitalee (marketing and communications)", "brand": "Trade and COO decks are professional, light on content and on white backgrounds. Reuse the design language of the SA destination and trade decks."}}, {"op": "set", "path": "os_clients/irth", "data": {"id": "irth", "name": "Irth", "agency": "Zoo Media", "by": "Setup", "at": "2026-11-13T00:00:00.000Z", "brand": "Canvas 10 x 5.625in. Instrument Serif for display, never bold. EB Garamond for titles. Helvetica Neue for body. Palette: white, IRTH yellow #FFDC40 and black. Brand book accents: Burgundy #761030 and Light Blue #CAE5E5."}}, {"op": "set", "path": "os_clients/bhor", "data": {"id": "bhor", "name": "Bhor", "agency": "Zoo Media", "by": "Setup", "at": "2026-11-13T00:00:00.000Z", "contacts": "Hrishikesh Kirkire (facility manager)", "brand": "Follow the design style of bhor.com, which Zoo built."}}, {"op": "set", "path": "os_clients/peru-tourism", "data": {"id": "peru-tourism", "name": "Peru Tourism", "agency": "The Starter Labs", "by": "Setup", "at": "2026-11-13T00:00:00.000Z", "category": "Travel & Tourism", "contacts": "Max", "brand": "All photos belong to PROMPERU."}}, {"op": "set", "path": "os_clients/mogu-mogu", "data": {"id": "mogu-mogu", "name": "Mogu Mogu", "agency": "The Starter Labs", "by": "Setup", "at": "2026-11-13T00:00:00.000Z"}}, {"op": "set", "path": "os_clients/chemistry", "data": {"id": "chemistry", "name": "Chemistry", "agency": "The Starter Labs", "by": "Setup", "at": "2026-11-13T00:00:00.000Z", "category": "D2C Fashion Apparel"}}, {"op": "set", "path": "os_clients/acmatec", "data": {"id": "acmatec", "name": "ACMATEC", "agency": "Zoo Media", "by": "Setup", "at": "2026-11-13T00:00:00.000Z"}}, {"op": "set", "path": "os_clients/nevora", "data": {"id": "nevora", "name": "Nevora", "agency": "Zoo Media", "by": "Setup", "at": "2026-11-13T00:00:00.000Z", "category": "Real Estate", "brand": "Original fonts only: Coconat and DM Sans."}}, {"op": "set", "path": "os_clients/suresh-surana-associates", "data": {"id": "suresh-surana-associates", "name": "Suresh Surana & Associates", "agency": "The Starter Labs", "by": "Setup", "at": "2026-11-13T00:00:00.000Z", "brand": "The firm name in a single line is the logo. Monochrome and text-led."}}, {"op": "set", "path": "os_clients/hsbc", "data": {"id": "hsbc", "name": "HSBC", "agency": "The Starter Labs", "by": "Setup", "at": "2026-11-13T00:00:00.000Z", "category": "BFSI", "brand": "Pull the brand from create.hsbc."}}, {"op": "set", "path": "os_clients/who-is-free-today", "data": {"id": "who-is-free-today", "name": "Who Is Free Today", "agency": "The Starter Labs", "by": "Setup", "at": "2026-11-13T00:00:00.000Z", "contacts": "Abhishek Nayar"}}, {"op": "set", "path": "os_rules/seed01", "data": {"id": "seed01", "client": "sa-tourism", "rule": "Decks for the travel trade and the COO are professional, light on content and on white backgrounds.", "source": "Karan's project rules", "active": true, "by": "Setup", "at": "2026-11-13T00:00:00.000Z"}}, {"op": "set", "path": "os_rules/seed02", "data": {"id": "seed02", "client": "sa-tourism", "rule": "Keep the slide count unchanged on a deck revamp unless asked.", "source": "Karan's project rules", "active": true, "by": "Setup", "at": "2026-11-13T00:00:00.000Z"}}, {"op": "set", "path": "os_rules/seed03", "data": {"id": "seed03", "client": "sa-tourism", "rule": "Reuse the design language of the SA destination and trade decks across new work.", "source": "Karan's project rules", "active": true, "by": "Setup", "at": "2026-11-13T00:00:00.000Z"}}, {"op": "set", "path": "os_rules/seed04", "data": {"id": "seed04", "client": "sa-tourism", "rule": "Bill work against the executed Zoo x SAT rate card. Quote the rate card line, note that rates include GST, and keep agency fees separate from vendor and talent costs.", "source": "Karan's project rules", "active": true, "by": "Setup", "at": "2026-11-13T00:00:00.000Z"}}, {"op": "set", "path": "os_rules/seed05", "data": {"id": "seed05", "client": "sa-tourism", "rule": "Anything not on the rate card needs an addendum or a separate estimate, with written approval before work starts.", "source": "Karan's project rules", "active": true, "by": "Setup", "at": "2026-11-13T00:00:00.000Z"}}, {"op": "set", "path": "os_rules/seed06", "data": {"id": "seed06", "client": "sa-tourism", "rule": "Do not use tournament branding or national flags in creatives, and show provinces beyond Cape Town.", "source": "Client feedback on the December OOH deck", "active": true, "by": "Setup", "at": "2026-11-13T00:00:00.000Z"}}, {"op": "set", "path": "os_rules/seed07", "data": {"id": "seed07", "client": "irth", "rule": "Use the IRTH design system: 10 x 5.625in canvas, Instrument Serif display that is never bold, EB Garamond titles, Helvetica Neue body, and a white, yellow #FFDC40 and black palette.", "source": "Karan's project rules", "active": true, "by": "Setup", "at": "2026-11-13T00:00:00.000Z"}}, {"op": "set", "path": "os_rules/seed08", "data": {"id": "seed08", "client": "bhor", "rule": "Client-facing material follows the design style of bhor.com.", "source": "Karan's project rules", "active": true, "by": "Setup", "at": "2026-11-13T00:00:00.000Z"}}, {"op": "set", "path": "os_rules/seed09", "data": {"id": "seed09", "client": "bhor", "rule": "Booth dashboards must work on phones.", "source": "Karan's project rules", "active": true, "by": "Setup", "at": "2026-11-13T00:00:00.000Z"}}, {"op": "set", "path": "os_rules/seed10", "data": {"id": "seed10", "client": "bhor", "rule": "Production and execution work is billed outside the Content Engine retainer.", "source": "Karan's project rules", "active": true, "by": "Setup", "at": "2026-11-13T00:00:00.000Z"}}, {"op": "set", "path": "os_rules/seed11", "data": {"id": "seed11", "client": "acmatec", "rule": "Build a journey-led site, not a copy of the client's reference site.", "source": "Karan's project rules", "active": true, "by": "Setup", "at": "2026-11-13T00:00:00.000Z"}}, {"op": "set", "path": "os_rules/seed12", "data": {"id": "seed12", "client": "acmatec", "rule": "The standby page goes on acmatec.com, not Netlify.", "source": "Karan's project rules", "active": true, "by": "Setup", "at": "2026-11-13T00:00:00.000Z"}}, {"op": "set", "path": "os_rules/seed13", "data": {"id": "seed13", "client": "nevora", "rule": "Use the original fonts only: Coconat and DM Sans.", "source": "Karan's project rules", "active": true, "by": "Setup", "at": "2026-11-13T00:00:00.000Z"}}, {"op": "set", "path": "os_rules/seed14", "data": {"id": "seed14", "client": "nevora", "rule": "Positioning is Mumbai only.", "source": "Karan's project rules", "active": true, "by": "Setup", "at": "2026-11-13T00:00:00.000Z"}}, {"op": "set", "path": "os_rules/seed15", "data": {"id": "seed15", "client": "nevora", "rule": "Never repeat a photo or a design treatment across pages.", "source": "Karan's project rules", "active": true, "by": "Setup", "at": "2026-11-13T00:00:00.000Z"}}, {"op": "set", "path": "os_rules/seed16", "data": {"id": "seed16", "client": "peru-tourism", "rule": "All photos belong to PROMPERU. Never add a \"partners\" credit.", "source": "Karan's project rules", "active": true, "by": "Setup", "at": "2026-11-13T00:00:00.000Z"}}, {"op": "set", "path": "os_rules/seed17", "data": {"id": "seed17", "client": "peru-tourism", "rule": "Use the client's spellings: Machupicchu, Nasca and Cebiche.", "source": "Client feedback on the microsite", "active": true, "by": "Setup", "at": "2026-11-13T00:00:00.000Z"}}, {"op": "set", "path": "os_rules/seed18", "data": {"id": "seed18", "client": "peru-tourism", "rule": "Keep client-facing documents to very short bullet points.", "source": "Karan, after microsite feedback rounds", "active": true, "by": "Setup", "at": "2026-11-13T00:00:00.000Z"}}, {"op": "set", "path": "os_rules/seed19", "data": {"id": "seed19", "client": "suresh-surana-associates", "rule": "The firm name in a single line is the logo.", "source": "Karan's project rules", "active": true, "by": "Setup", "at": "2026-11-13T00:00:00.000Z"}}, {"op": "set", "path": "os_rules/seed20", "data": {"id": "seed20", "client": "suresh-surana-associates", "rule": "The site is monochrome and text-led.", "source": "Karan's project rules", "active": true, "by": "Setup", "at": "2026-11-13T00:00:00.000Z"}}, {"op": "set", "path": "os_rules/seed21", "data": {"id": "seed21", "client": "suresh-surana-associates", "rule": "All copy must stay within ICAI rules.", "source": "Karan's project rules", "active": true, "by": "Setup", "at": "2026-11-13T00:00:00.000Z"}}, {"op": "set", "path": "os_rules/seed22", "data": {"id": "seed22", "client": "hsbc", "rule": "Pull the brand from create.hsbc and never redraw the HSBC logo.", "source": "Karan's project rules", "active": true, "by": "Setup", "at": "2026-11-13T00:00:00.000Z"}}, {"op": "set", "path": "os_rules/seed23", "data": {"id": "seed23", "client": "hsbc", "rule": "The audience is senior, so prefer plain scroll over scroll-to-reveal effects.", "source": "Karan's project rules", "active": true, "by": "Setup", "at": "2026-11-13T00:00:00.000Z"}}, {"op": "set", "path": "os_rules/seed24", "data": {"id": "seed24", "client": "hsbc", "rule": "Do not use globe, aeroplane or world-map imagery.", "source": "HSBC brand guidelines", "active": true, "by": "Setup", "at": "2026-11-13T00:00:00.000Z"}}, {"op": "set", "path": "os_rules/seed25", "data": {"id": "seed25", "client": "hsbc", "rule": "Lead with education before lifestyle, and build the pitch on use cases, not on the product functions.", "source": "Client reviews, October 2026", "active": true, "by": "Setup", "at": "2026-11-13T00:00:00.000Z"}}, {"op": "set", "path": "os_rules/seed26", "data": {"id": "seed26", "client": "mogu-mogu", "rule": "Plan activations for content output, not for gathering influencers.", "source": "Client feedback on the Q4 activity grid", "active": true, "by": "Setup", "at": "2026-11-13T00:00:00.000Z"}}, {"op": "set", "path": "os_rules/seed27", "data": {"id": "seed27", "client": "chemistry", "rule": "Keep the strategy non-festive, because the collection is not festive.", "source": "Karan, OND pitch direction", "active": true, "by": "Setup", "at": "2026-11-13T00:00:00.000Z"}}, {"op": "set", "path": "os_rules/seed28", "data": {"id": "seed28", "client": "chemistry", "rule": "Sales are online only. There are no offline stores.", "source": "Karan, OND pitch direction", "active": true, "by": "Setup", "at": "2026-11-13T00:00:00.000Z"}}, {"op": "set", "path": "os_rules/seed29", "data": {"id": "seed29", "client": "who-is-free-today", "rule": "The client does not work in marketing or paid media, so write client material in plain, simple language.", "source": "Karan, paid media plan", "active": true, "by": "Setup", "at": "2026-11-13T00:00:00.000Z"}}]